{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.BaseURL | absURL }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml"/>
    {{- range first 20 site.RegularPages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- with .Description }}
      <description>{{ . }}</description>
      {{- else }}
      <description>{{ .Summary | plainify | replaceRE `\$\$[\s\S]*?\$\$` " " | replaceRE `\$[^$]*\$` " " | replaceRE `\s+` " " | strings.TrimSpace | truncate 160 }}</description>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
